---
import { equipmentCategoryLabel } from '../lib/site';

interface Props {
  slug: string;
  name: string;
  category: string;
  summary: string;
  image: string;
  imageAlt: string;
}

const { slug, name, category, summary, image, imageAlt } = Astro.props;
---

<a
  href={`/equipment/${slug}`}
  class="group flex flex-col overflow-hidden rounded-card-lg bg-surface transition hover:-translate-y-1 hover:shadow-lg"
  data-equipment-card
  data-category={category}
>
  <div class="aspect-[4/3] w-full overflow-hidden bg-ink-soft">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <span class="text-[11px] font-semibold uppercase tracking-wide text-text-secondary">
      {equipmentCategoryLabel(category)}
    </span>
    <h3 class="mt-2 font-display text-lg font-bold leading-snug tracking-tightest text-text-primary">
      {name}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm text-text-secondary">{summary}</p>
    <span class="mt-4 text-sm font-semibold text-text-primary group-hover:text-accent-ink">
      View Specs →
    </span>
  </div>
</a>
