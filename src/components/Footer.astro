---
import { NAV_LINKS, SERVICE_LINKS, SITE, withBase } from '../lib/site';
import Button from './Button.astro';
import GradientMesh from './GradientMesh.astro';

const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden bg-ink text-text-inverse">
  <GradientMesh tone="amber" class="opacity-60" />
  <div class="container-page py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]" data-reveal>
      <div>
        <h2 class="font-display text-4xl font-bold leading-[0.95] tracking-tightest sm:text-5xl">
          <span class="block text-text-inverse">The next generation of</span>
          <span class="block text-text-inverse-muted">oil &amp; gas equipment.</span>
        </h2>
        <p class="mt-6 max-w-md text-sm text-text-inverse-muted">
          {SITE.legalName} provides specialist oilfield equipment and services from our base in
          Abu Dhabi, UAE.
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="accent">Get in Touch</Button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
        <div>
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-wide text-text-inverse-muted">
            Sitemap
          </p>
          <ul class="space-y-2">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a href={withBase(link.href)} class="text-text-inverse-muted hover:text-text-inverse">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-wide text-text-inverse-muted">
            Services
          </p>
          <ul class="space-y-2">
            {
              SERVICE_LINKS.map((link) => (
                <li>
                  <a href={withBase(link.href)} class="text-text-inverse-muted hover:text-text-inverse">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-wide text-text-inverse-muted">
            Contact Us
          </p>
          <ul class="space-y-2 text-text-inverse-muted">
            <li>{SITE.address}</li>
            <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="hover:text-text-inverse">{SITE.phone}</a></li>
            <li><a href={`mailto:${SITE.email}`} class="hover:text-text-inverse">{SITE.email}</a></li>
            <li>Sun–Thu · 08:00–17:00</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 border-t border-border-dark pt-8">
      <div
        class="relative isolate flex flex-col items-start justify-between gap-6 overflow-hidden rounded-card-lg bg-ink-soft px-6 py-10 text-accent sm:flex-row sm:items-end sm:px-10"
        data-reveal
      >
        <div
          class="pointer-events-none absolute -left-[5%] -top-[60%] h-[220%] w-[35%] rounded-full opacity-25 blur-[100px]"
          style="background: radial-gradient(circle, #FFC01E 0%, transparent 70%);"
          aria-hidden="true"
        />
        <div class="relative flex items-center gap-4">
          <img src={withBase('/images/brand/icon.png')} alt="" width="40" height="56" class="hidden h-16 w-auto sm:block" />
          <p class="font-display text-[15vw] font-extrabold leading-[0.8] tracking-tightest text-text-inverse sm:text-[9vw] lg:text-[110px]">
            Matar Bin Fraih
          </p>
        </div>
        <div class="relative flex shrink-0 items-center gap-4 text-text-inverse">
          <span class="text-xs text-text-inverse-muted">©{year}</span>
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-pill border border-border-dark px-4 py-2 text-xs font-semibold hover:border-accent hover:text-accent"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 text-xs text-text-inverse-muted sm:flex-row sm:items-center">
      <p>© {SITE.shortName} {year}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href={withBase('/privacy-policy')} class="hover:text-text-inverse">Privacy Policy</a>
        <a href={withBase('/terms-and-conditions')} class="hover:text-text-inverse">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>
