---
// Partner/client logo strip — design-system.md §4.4.
// Infinite auto-scrolling marquee of real client logos, plain grayscale
// (colorizing on hover) directly on the page background — no card chrome,
// to stay light and out of the way. The track is duplicated once for a
// seamless loop and pauses on hover/focus so a visitor can read a label.
const logos = [
  { file: 'client-1.webp', name: 'BJ Services' },
  { file: 'client-2.webp', name: 'ESNAAD — ADNOC Group' },
  { file: 'client-3.webp', name: 'Bin Fraih Group' },
  { file: 'client-4.webp', name: 'Al Ahlia Oil Fields Development Co.' },
  { file: 'client-5.webp', name: 'Safwan Petroleum Technologies Establishment' },
  { file: 'client-6.webp', name: 'National Drilling Company' },
  { file: 'client-7.webp', name: 'Baker Hughes' },
  { file: 'client-8.webp', name: 'Schlumberger' },
];
const track = [...logos, ...logos];
---

<div class="fade-edges group/marquee overflow-hidden">
  <div
    class="flex w-max items-center gap-16 [animation:marquee_32s_linear_infinite] group-hover/marquee:[animation-play-state:paused]"
  >
    {
      track.map((logo, i) => (
        <img
          src={`/images/clients/${logo.file}`}
          alt={i < logos.length ? logo.name : ''}
          width="160"
          height="70"
          loading="lazy"
          class="h-10 w-auto shrink-0 object-contain opacity-60 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0"
          aria-hidden={i >= logos.length ? 'true' : undefined}
        />
      ))
    }
  </div>
</div>
