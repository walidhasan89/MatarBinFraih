---
import { NAV_LINKS, SITE } from '../lib/site';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!--
  No background color, per client request — the bar floats transparently
  over whatever's beneath it. `h-0 overflow-visible` keeps it sticky at the
  top WITHOUT reserving flow space, so it actually overlays the dark hero
  band every page opens with (PageHero / homepage hero) instead of sitting
  in the light page background above it — that mismatch was the original
  cause of low-contrast nav text. Once scrolled past the hero, the script
  below adds a translucent blurred backdrop so the (light-colored) nav text
  stays readable over whatever section has scrolled underneath — the bar
  itself still has no solid background color, only a blur.
-->
<header class="sticky top-0 z-50 h-0 w-full overflow-visible" data-navbar>
  <nav class="container-page flex items-center justify-between gap-4 py-4 transition-[background-color,backdrop-filter,box-shadow] duration-300" data-navbar-inner>
    <a href="/" class="group flex shrink-0 items-center gap-2 text-text-inverse" aria-label="MBF home">
      <img
        src="/images/brand/icon.png"
        alt=""
        width="32"
        height="44"
        class="h-11 w-auto transition-transform duration-300 group-hover:scale-110"
      />
      <span class="font-display text-lg font-bold tracking-tightest">MBF</span>
    </a>

    <div class="hidden items-center gap-2 rounded-pill bg-white/5 p-1.5 backdrop-blur md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class={`rounded-pill px-4 py-2 text-sm font-medium transition-colors ${
              isActive(link.href)
                ? 'bg-white/10 text-text-inverse'
                : 'text-text-inverse-muted hover:text-text-inverse'
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="hidden md:block">
      <Button href="/contact" variant="accent">Get in Touch</Button>
    </div>

    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-pill bg-white/10 text-text-inverse md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-mobile-toggle
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" data-icon-open>
        <path d="M2 5H18M2 10H18M2 15H18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="hidden" data-icon-close>
        <path d="M3 3L17 17M17 3L3 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div
    class="fixed inset-0 z-[60] hidden flex-col overflow-y-auto bg-ink text-text-inverse opacity-0 transition-opacity duration-300 ease-out md:hidden"
    data-mobile-panel
  >
    <div
      class="pointer-events-none absolute -right-[15%] -top-[20%] h-[60%] w-[70%] rounded-full opacity-30 blur-[110px]"
      style="background: radial-gradient(circle, #FFC01E 0%, transparent 70%);"
      aria-hidden="true"
    />

    <div class="container-page relative flex items-center justify-between py-4">
      <a href="/" class="flex shrink-0 items-center gap-2" aria-label="MBF home" data-mobile-close>
        <img src="/images/brand/icon.png" alt="" width="32" height="44" class="h-11 w-auto" />
        <span class="font-display text-lg font-bold tracking-tightest">MBF</span>
      </a>
      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-pill bg-white/10 text-text-inverse transition hover:bg-white/20"
        aria-label="Close menu"
        data-mobile-close
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 3L17 17M17 3L3 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="container-page relative flex flex-1 flex-col justify-center gap-1 py-8" aria-label="Mobile">
      {
        NAV_LINKS.map((link, i) => (
          <a
            href={link.href}
            data-mobile-link
            style={`transition-delay:${i * 60}ms`}
            class={`translate-y-4 border-b border-white/10 py-4 font-display text-4xl font-bold tracking-tightest opacity-0 transition-all duration-500 ease-out ${
              isActive(link.href) ? 'text-accent' : 'text-text-inverse'
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div
      class="container-page relative flex translate-y-4 flex-col gap-4 pb-10 opacity-0 transition-all duration-500 ease-out"
      data-mobile-link
      style={`transition-delay:${NAV_LINKS.length * 60}ms`}
    >
      <a href="/contact" class="rounded-pill bg-accent px-4 py-4 text-center text-sm font-semibold text-accent-ink">
        Get in Touch
      </a>
      <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="text-center text-sm text-text-inverse-muted">
        {SITE.phone}
      </a>
    </div>
  </div>
</header>

<script>
  // Minimal-JS mobile nav island (no framework — plain DOM). The panel is a
  // full-screen overlay: `hidden` is toggled off first so the transition has
  // something to animate from, then the opacity/translate classes flip on
  // the next frame (rAF) so the browser registers the "before" state first.
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const panel = document.querySelector<HTMLDivElement>('[data-mobile-panel]');
  const closers = document.querySelectorAll<HTMLElement>('[data-mobile-close]');
  const links = document.querySelectorAll<HTMLElement>('[data-mobile-link]');
  const iconOpen = document.querySelector('[data-icon-open]');
  const iconClose = document.querySelector('[data-icon-close]');
  const CLOSE_ANIMATION_MS = 300;

  let isOpen = false;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function openMenu() {
    isOpen = true;
    clearTimeout(closeTimer);
    panel?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      panel?.classList.remove('opacity-0');
      panel?.classList.add('opacity-100');
      links.forEach((link) => {
        link.classList.remove('opacity-0', 'translate-y-4');
      });
    });
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    isOpen = false;
    panel?.classList.remove('opacity-100');
    panel?.classList.add('opacity-0');
    links.forEach((link) => {
      link.classList.add('opacity-0', 'translate-y-4');
    });
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    closeTimer = setTimeout(() => panel?.classList.add('hidden'), CLOSE_ANIMATION_MS);
  }

  toggle?.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()));
  closers.forEach((el) => el.addEventListener('click', closeMenu));
  links.forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });

  // Adds a blurred backdrop (no solid color) once the page has scrolled
  // past the dark hero band every page opens with, so nav text stays
  // legible over lighter sections scrolling underneath the sticky bar.
  const navInner = document.querySelector<HTMLElement>('[data-navbar-inner]');
  const SCROLLED_THRESHOLD = 80;

  function updateNavScrollState() {
    navInner?.classList.toggle('is-scrolled', window.scrollY > SCROLLED_THRESHOLD);
  }

  window.addEventListener('scroll', updateNavScrollState, { passive: true });
  updateNavScrollState();
</script>
