---
interface Props {
  name: string;
  role: string;
  phone?: string;
  email?: string;
  avatar: string;
}

const { name, role, phone, email, avatar } = Astro.props;
---

<div class="flex flex-col items-center rounded-card-lg bg-surface p-6 text-center transition-transform duration-300 hover:-translate-y-1 hover:shadow-lg">
  <img src={avatar} alt={`Placeholder avatar for ${name} — TODO: replace with real headshot`} width="96" height="96" loading="lazy" class="h-24 w-24 rounded-full object-cover" />
  <p class="mt-4 font-display text-base font-bold tracking-tightest text-text-primary">{name}</p>
  <p class="text-sm text-text-secondary">{role}</p>
  <div class="mt-3 flex flex-col gap-1 text-xs text-text-secondary">
    {phone && <a href={`tel:${phone.replace(/\s/g, '')}`} class="hover:text-text-primary">{phone}</a>}
    {email && <a href={`mailto:${email}`} class="hover:text-text-primary">{email}</a>}
  </div>
</div>
