---
// Blueprint-style line-art illustration of an MBF storage tank skid, with
// dimension callouts — design-system.md §4.6. Hand-drawn inline SVG rather
// than a photo, matching the reference's engineering-schematic motif.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`hatch-pattern relative flex items-center justify-center overflow-hidden rounded-card-lg bg-ink-soft p-8 text-text-inverse-muted ${className}`}>
  <svg
    viewBox="0 0 420 340"
    class="h-full w-full max-w-[420px] text-accent"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    aria-labelledby="techDiagramTitle"
    role="img"
  >
    <title id="techDiagramTitle">Line-art schematic of an MBF skid-mounted storage tank</title>
    <!-- tank shell -->
    <rect x="70" y="90" width="230" height="120" rx="18" />
    <ellipse cx="70" cy="150" rx="18" ry="60" />
    <ellipse cx="300" cy="150" rx="18" ry="60" />
    <!-- walkway & ladder -->
    <line x1="70" y1="212" x2="300" y2="212" />
    <line x1="55" y1="230" x2="315" y2="230" />
    <line x1="90" y1="212" x2="90" y2="230" />
    <line x1="150" y1="212" x2="150" y2="230" />
    <line x1="210" y1="212" x2="210" y2="230" />
    <line x1="270" y1="212" x2="270" y2="230" />
    <!-- manhole -->
    <circle cx="185" cy="95" r="14" />
    <!-- skid frame -->
    <rect x="40" y="245" width="300" height="24" rx="4" />
    <line x1="60" y1="269" x2="60" y2="290" />
    <line x1="320" y1="269" x2="320" y2="290" />

    <!-- dimension callouts -->
    <g stroke-dasharray="2 3" opacity="0.6">
      <line x1="40" y1="300" x2="340" y2="300" />
      <line x1="40" y1="292" x2="40" y2="308" />
      <line x1="340" y1="292" x2="340" y2="308" />
    </g>
    <text x="190" y="318" text-anchor="middle" font-size="11" fill="currentColor" stroke="none" font-family="monospace">32.5"</text>

    <g stroke-dasharray="2 3" opacity="0.6">
      <line x1="358" y1="90" x2="358" y2="230" />
      <line x1="350" y1="90" x2="366" y2="90" />
      <line x1="350" y1="230" x2="366" y2="230" />
    </g>
    <text x="368" y="163" font-size="11" fill="currentColor" stroke="none" font-family="monospace" transform="rotate(90 368 163)">18"</text>

    <g stroke-dasharray="2 3" opacity="0.6">
      <line x1="18" y1="90" x2="18" y2="270" />
      <line x1="10" y1="90" x2="26" y2="90" />
      <line x1="10" y1="270" x2="26" y2="270" />
    </g>
    <text x="18" y="60" text-anchor="middle" font-size="11" fill="currentColor" stroke="none" font-family="monospace">10.5"</text>
  </svg>
</div>
