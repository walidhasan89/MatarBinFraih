---
// Staggered testimonial card — design-system.md §4.9.
// Vertical offset (the zig-zag rhythm) is applied by the parent grid via
// the `offset` prop, not hardcoded here, so any grid size can stagger it.
import { withBase } from '../lib/site';

interface Props {
  quote: string;
  name: string;
  role: string;
  avatar: string;
  offset?: boolean;
  glass?: boolean;
  class?: string;
}

const { quote, name, role, avatar, offset = false, glass = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    // Translate-based hover lift would fight the zig-zag `offset` translate
    // (both write --tw-translate-y), so hover feedback here is shadow-only.
    'rounded-card-lg p-7 transition-shadow duration-300 hover:shadow-xl',
    glass ? 'glass-light' : 'bg-surface',
    offset ? 'sm:translate-y-8' : '',
    className,
  ]}
>
  <p class="text-sm leading-relaxed text-text-secondary">&ldquo;{quote}&rdquo;</p>
  <div class="mt-6 flex items-center gap-3">
    <img src={withBase(avatar)} alt="" width="40" height="40" loading="lazy" class="h-10 w-10 rounded-full object-cover" />
    <div>
      <p class="text-sm font-semibold text-text-primary">{name}</p>
      <p class="text-xs text-text-secondary">{role}</p>
    </div>
  </div>
</div>
