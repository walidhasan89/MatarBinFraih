---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../lib/site';
import { organizationSchema, localBusinessSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  noindex?: boolean;
  /** Extra page-specific JSON-LD (breadcrumbs, Product, Service, FAQPage, etc.), rendered alongside the sitewide Organization/LocalBusiness schema. */
  schema?: object | object[];
}

const {
  title,
  description,
  ogImage = '/images/og/og-default.png',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const pageTitle = title.includes('MBF') ? title : `${title} | Matar Bin Fraih (MBF)`;
const pageSchemas = [organizationSchema(), localBusinessSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? SITE.url)} />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:locale" content="en_AE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? SITE.url)} />

    <!-- Local SEO: MBF is a physical Abu Dhabi business, not a nationwide/online-only brand. -->
    <meta name="geo.region" content="AE-AZ" />
    <meta name="geo.placename" content={`${SITE.addressLocality}, ${SITE.addressRegion}`} />
    <meta name="geo.position" content={`${SITE.latitude};${SITE.longitude}`} />
    <meta name="ICBM" content={`${SITE.latitude}, ${SITE.longitude}`} />

    <meta name="generator" content={Astro.generator} />

    <JsonLd schema={pageSchemas} />
  </head>
  <body class="min-h-screen bg-bg">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
