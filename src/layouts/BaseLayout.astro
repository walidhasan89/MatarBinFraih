---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import { SITE } from '../lib/site';
import { organizationSchema, localBusinessSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  noindex?: boolean;
  /** Extra page-specific JSON-LD (breadcrumbs, Product, Service, FAQPage, etc.), rendered alongside the sitewide Organization/LocalBusiness schema. */
  schema?: object | object[];
}

const {
  title,
  description,
  ogImage = '/images/og/og-default.png',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const pageTitle = title.includes('MBF') ? title : `${title} | Matar Bin Fraih (MBF)`;
const pageSchemas = [organizationSchema(), localBusinessSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? SITE.url)} />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:locale" content="en_AE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? SITE.url)} />

    <!-- Local SEO: MBF is a physical Abu Dhabi business, not a nationwide/online-only brand. -->
    <meta name="geo.region" content="AE-AZ" />
    <meta name="geo.placename" content={`${SITE.addressLocality}, ${SITE.addressRegion}`} />
    <meta name="geo.position" content={`${SITE.latitude};${SITE.longitude}`} />
    <meta name="ICBM" content={`${SITE.latitude}, ${SITE.longitude}`} />

    <meta name="generator" content={Astro.generator} />

    <JsonLd schema={pageSchemas} />
  </head>
  <body class="min-h-screen bg-bg">
    <ScrollProgress />
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Sitewide scroll-reveal: any element with `data-reveal` fades/slides
      // into place the first time it enters the viewport. One shared
      // observer for the whole page — sections opt in just by adding the
      // attribute, no per-component JS needed. Respects
      // prefers-reduced-motion via the global CSS override (transitions
      // collapse to ~0, so elements just appear).
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (targets.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );

        targets.forEach((el, i) => {
          const delay = el.dataset.revealDelay ?? String(Math.min(i % 4, 3) * 90);
          el.style.setProperty('--reveal-delay', `${delay}ms`);
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
