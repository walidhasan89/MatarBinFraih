---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillTag from '../components/PillTag.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Browse MBF's equipment catalog and services instead."
  noindex
>
  <section class="container-page flex min-h-[70vh] flex-col items-start justify-center py-section">
    <PillTag label="404" />
    <h1 class="mt-6 font-display text-4xl font-bold leading-[0.95] tracking-tightest text-text-primary sm:text-6xl">
      Page not found.
      <span class="block text-text-secondary">Let's get you back on site.</span>
    </h1>
    <p class="mt-6 max-w-lg text-sm text-text-secondary sm:text-base">
      The page you're looking for may have moved or no longer exists. Try the equipment catalog, our services,
      or head back home.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/" variant="primary">Back to Home</Button>
      <Button href="/equipment" variant="secondary">Browse Equipment</Button>
    </div>
  </section>
</BaseLayout>
