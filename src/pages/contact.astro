---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import TeamCard from '../components/TeamCard.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const team = await getCollection('team');

const infoCards = [
  { label: 'Our Mails', value: SITE.email, href: `mailto:${SITE.email}` },
  { label: 'Our Phones', value: `${SITE.phone} / ${SITE.mobile}`, href: `tel:${SITE.phone.replace(/\s/g, '')}` },
  { label: 'Our Address', value: SITE.address, href: SITE.mapsUrl },
];

const pageSchema = breadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Contact', url: `${SITE.url}/contact` },
]);
---

<BaseLayout
  title="Contact Us — Oilfield Equipment Rental in Abu Dhabi, UAE"
  description="Get in touch with Matar Bin Fraih Trading & Oilfield Equipment Rental in Abu Dhabi, UAE — phone, email, WhatsApp and our team's direct contacts."
  schema={pageSchema}
>
  <PageHero eyebrow="Contact" lineOne="Do you have any questions?" lineTwo="Feel free to contact us today." />

  <section class="container-page py-section">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        infoCards.map((card, i) => (
          <div data-reveal data-reveal-delay={String(i * 90)}>
            <a
              href={card.href}
              target={card.label === 'Our Address' ? '_blank' : undefined}
              rel={card.label === 'Our Address' ? 'noopener noreferrer' : undefined}
              class="block rounded-card-lg bg-surface p-6 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-1 hover:ring-accent/40"
            >
              <p class="text-[11px] font-semibold uppercase tracking-wide text-text-secondary">{card.label}</p>
              <p class="mt-3 text-base font-semibold text-text-primary">{card.value}</p>
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-16" data-reveal>
      <SectionHeading eyebrow="Get In Touch" lineOne="Send us a" lineTwo="message." />
      <div class="mt-8">
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="container-page pb-section">
    <div data-reveal>
      <SectionHeading eyebrow="Our Team" lineOne="Meet the people" lineTwo="behind every project." />
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.map((member, i) => (
          <div data-reveal data-reveal-delay={String(i * 90)}>
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              phone={member.data.phone}
              email={member.data.email}
              avatar={member.data.avatar}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-page pb-section">
    <div data-reveal>
      <SectionHeading eyebrow="Find Us" lineOne="Our location in" lineTwo="Abu Dhabi." />
    </div>
    <div class="mt-8 overflow-hidden rounded-card-lg" data-reveal data-reveal-delay="120">
      <iframe
        title="MBF location — Abu Rayyal St, Madinat Zayed, Abu Dhabi, UAE"
        src={SITE.mapEmbedUrl}
        width="100%"
        height="420"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </div>
  </section>
</BaseLayout>
