---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EquipmentCard from '../../components/EquipmentCard.astro';
import EquipmentFilter from '../../components/EquipmentFilter.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const equipment = (await getCollection('equipment')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const pageSchema = breadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Equipment', url: `${SITE.url}/equipment` },
]);
---

<BaseLayout
  title="Oilfield Equipment Rental Catalog — Storage Tanks, Pumps & Caravans"
  description="Browse MBF's full oilfield equipment catalog in Abu Dhabi — storage tanks, pumps, well-control equipment, caravans & cabins, and specialized units, all available for rental."
  schema={pageSchema}
>
  <PageHero
    eyebrow="Our Equipment"
    lineOne="Built to perform,"
    lineTwo="proven to last in the field."
    intro="One catalog for every rental unit MBF manufactures and maintains — storage tanks, pumps, well-control equipment, caravans and specialized units."
  />

  <section class="container-page py-section">
    <div data-reveal>
      <SectionHeading eyebrow="Catalog" lineOne="Filter by" lineTwo="equipment category." />
    </div>

    <div class="mt-8" data-reveal data-reveal-delay="90">
      <EquipmentFilter />
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        equipment.map((item, i) => (
          <div data-reveal data-reveal-delay={String((i % 6) * 60)}>
            <EquipmentCard
              slug={item.id}
              name={item.data.name}
              category={item.data.category}
              summary={item.data.summary}
              image={item.data.image}
              imageAlt={item.data.imageAlt}
            />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
