---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PillTag from '../components/PillTag.astro';
import Button from '../components/Button.astro';
import GradientMesh from '../components/GradientMesh.astro';
import { SITE, EQUIPMENT_CATEGORIES, whatsappLink, withBase } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const equipment = await getCollection('equipment');

const groups = EQUIPMENT_CATEGORIES.map((cat) => ({
  ...cat,
  items: equipment.filter((e) => e.data.category === cat.slug).sort((a, b) => a.data.name.localeCompare(b.data.name)),
})).filter((group) => group.items.length > 0);

const pageUrl = `${SITE.url}/rental-equipment`;
const pageSchema = breadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Rental Equipments', url: pageUrl },
]);
---

<BaseLayout
  title="Rental Equipments — Full Fleet Available in Abu Dhabi"
  description="Browse MBF's complete rental fleet — storage tanks, pumps, well-control equipment, caravans and specialized units — all manufactured and maintained in-house in Abu Dhabi, UAE."
  schema={pageSchema}
>
  <PageHero
    eyebrow="Rental Equipments"
    lineOne="Welcome to Matar Bin Fraih —"
    lineTwo="Trading & Oilfield Equipment Rental."
    intro="MBF is a trusted name in oilfield equipment manufacturing in the local and regional markets. Every unit below is available for rent, manufactured and maintained to our certified HSEQ standard."
  />

  <!--
    Jump-nav: sticks below the site header (which has no background of its
    own — see Navbar.astro) so it needs its own solid backdrop to stay
    legible. `top-20` clears the header's ~80px row; each category section
    below carries a matching `scroll-mt-28` so an anchor jump doesn't land
    underneath either bar.
  -->
  <nav
    class="sticky top-20 z-40 border-y border-border bg-bg/95 py-3 backdrop-blur"
    aria-label="Jump to equipment category"
  >
    <div class="container-page flex flex-wrap gap-2">
      {
        groups.map((group) => (
          <a
            href={`#${group.slug}`}
            class="rounded-pill border border-border bg-surface px-4 py-1.5 text-sm font-medium text-text-secondary transition hover:border-ink hover:text-text-primary"
          >
            {group.label}
          </a>
        ))
      }
    </div>
  </nav>

  {
    groups.map((group, groupIndex) => (
      <section id={group.slug} class="container-page scroll-mt-28 py-section">
        <div class="flex items-center gap-4" data-reveal>
          <PillTag label={group.label} />
          <div class="h-px flex-1 bg-border" />
        </div>

        <div class="mt-10 space-y-20">
          {group.items.map((item, i) => {
            const reversed = (groupIndex + i) % 2 === 1;
            return (
              <a
                href={withBase(`/equipment/${item.id}`)}
                class="group grid items-center gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16"
                data-reveal
              >
                <div class={`relative overflow-hidden rounded-card-lg shadow-sm transition-shadow duration-300 group-hover:shadow-xl ${reversed ? 'lg:order-2' : ''}`}>
                  <img
                    src={withBase(item.data.image)}
                    alt={item.data.imageAlt}
                    loading="lazy"
                    class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class={`relative isolate ${reversed ? 'lg:order-1' : ''}`}>
                  <div
                    class={`pointer-events-none absolute -top-10 h-40 w-40 rounded-full opacity-20 blur-[80px] ${reversed ? '-right-10' : '-left-10'}`}
                    style="background: radial-gradient(circle, #FFC01E 0%, transparent 70%);"
                    aria-hidden="true"
                  />
                  <p class="relative text-[11px] font-semibold uppercase tracking-wide text-text-secondary">
                    {group.label}
                  </p>
                  <h2 class="relative mt-2 font-display text-2xl font-bold leading-tight tracking-tightest text-text-primary transition-colors group-hover:text-accent-ink sm:text-3xl">
                    {item.data.name}
                  </h2>
                  <p class="relative mt-3 text-sm text-text-secondary sm:text-base">{item.data.summary}</p>
                  <ul class="relative mt-4 space-y-2">
                    {item.data.specs.slice(0, 3).map((spec) => (
                      <li class="flex gap-3 text-sm text-text-secondary">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                        <span>{spec}</span>
                      </li>
                    ))}
                  </ul>
                  <span class="relative mt-6 inline-flex items-center gap-3 rounded-pill border border-border py-2 pl-6 pr-6 text-sm font-semibold text-text-primary transition-colors group-hover:border-ink">
                    Request Data Sheet
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }

  <section class="container-page pb-section">
    <div
      class="relative isolate flex flex-col items-start justify-between gap-6 overflow-hidden rounded-card-lg bg-ink p-8 text-text-inverse sm:flex-row sm:items-center sm:p-10"
      data-reveal
    >
      <GradientMesh tone="amber" class="opacity-30" />
      <div class="relative">
        <p class="font-display text-2xl font-bold tracking-tightest">Can't find what you're looking for?</p>
        <p class="mt-2 max-w-lg text-sm text-text-inverse-muted">
          Tell us what your site needs and we'll confirm pricing and availability from our full fleet.
        </p>
      </div>
      <div class="relative flex shrink-0 flex-wrap gap-4">
        <Button href="/contact" variant="accent" class="glossy">Contact Us</Button>
        <Button
          href={whatsappLink("Hello, I'd like to enquire about your rental equipment fleet.")}
          variant="secondary-inverse"
          external
        >
          Chat on WhatsApp
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
